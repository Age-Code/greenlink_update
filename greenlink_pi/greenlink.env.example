# greenlink.env 템플릿
#
# 이 파일을 같은 디렉터리에 greenlink.env로 복사한 뒤 실제 값을 채운다.
# run_sensor.sh / run_camera.sh / run_command.sh가 실행 전에 읽어들이며,
# 값이 없으면 config.py가 RuntimeError로 즉시 실패한다.

# Backend 주소 (예: https://api.example.com)
GREENLINK_BASE_URL=<backend-base-url>

# Backend에 등록된 이 라즈베리파이의 장치 키
GREENLINK_DEVICE_KEY=<raspberry-pi-device-key>

# Ubuntu AI Worker의 /process 주소 (예: https://ai.example.com/process)
GREENLINK_AI_WORKER_URL=<ai-worker-process-url>

# AI Worker .env의 AI_PROCESS_SECRET과 동일한 값 (X-AI-Process-Secret 헤더로 전송)
GREENLINK_AI_PROCESS_SECRET=<ai-process-shared-secret>

# 카메라 crop 영역과 연결할 Backend userPlantId.
# Backend DB의 실제 값과 다르면 다른 식물에 사진이 올라간다.
GREENLINK_SUNFLOWER_USER_PLANT_ID=<sunflower-user-plant-id>
GREENLINK_BASIL_USER_PLANT_ID=<basil-user-plant-id>
