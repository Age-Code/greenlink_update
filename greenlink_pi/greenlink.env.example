# greenlink.env 템플릿
#
# 이 파일을 같은 디렉터리에 greenlink.env로 복사한 뒤 실제 값을 채운다.
# (scripts/setup_iot.py를 실행하면 자동으로 만들어진다.)
# systemd 서비스(greenlink-command, greenlink-stream)와 cron 스크립트(run_sensor.sh, run_camera.sh)가 읽으며,
# 필수 값이 없으면 config.py가 RuntimeError로 즉시 실패한다.

# Backend 주소 (예: https://greenlink.likepigs.shop)
GREENLINK_BASE_URL=<backend-base-url>

# Backend에 등록된 이 라즈베리파이의 장치 키
GREENLINK_DEVICE_KEY=<raspberry-pi-device-key>

# (선택) 사진을 붙일 식물의 Backend userPlantId.
# 비워 두면 Backend가 이 재배기에 연결된 현재 식물에 붙인다. 수확 후 새로 심어도 고칠 필요가 없어 비워 두는 것을 권장한다.
# GREENLINK_USER_PLANT_ID=

# (선택) 펌프 릴레이가 연결된 BCM GPIO. 생략하면 22.
# Backend PumpChannel의 gpioPin과 같은 값이어야 한다. LED(27)와 겹치면 안 된다.
# 바꾸면 /boot/firmware/config.txt의 gpio=22,27=op,dh 줄도 같이 바꾼다.
# GREENLINK_PUMP_GPIO=22
