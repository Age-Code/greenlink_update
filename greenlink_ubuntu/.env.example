# .env 템플릿
#
# 이 파일을 .env로 복사한 뒤 실제 값을 채운다.
# python-dotenv가 s3_client.py / openai_transform.py에서 읽어들인다.
# 값이 없으면 해당 단계에서 RuntimeError로 실패한다.

# 이미지 변환에 사용할 OpenAI API 키
OPENAI_API_KEY=<openai-api-key>

# Backend와 동일한 bucket / region을 사용해야 한다.
S3_BUCKET=<s3-bucket-name>
AWS_REGION=<aws-region>

# AI 결과 callback을 보낼 Backend 주소 (예: https://api.example.com)
BACKEND_BASE_URL=<backend-base-url>

# Backend의 greenlink.ai.worker-secret과 반드시 동일한 값
#   openssl rand -hex 32
AI_WORKER_SECRET=<ai-worker-shared-secret>

# Raspberry Pi가 /process 호출 시 X-AI-Process-Secret 헤더로 보내는 값.
# Pi greenlink.env의 GREENLINK_AI_PROCESS_SECRET과 반드시 동일해야 하며,
# 위 AI_WORKER_SECRET과는 다른 값을 쓴다. 비어 있으면 /process는 503을 반환한다.
#   openssl rand -hex 32
AI_PROCESS_SECRET=<ai-process-shared-secret>

# AWS 자격 증명은 여기에 두지 않는다.
# boto3 기본 credential provider chain(instance role 등)을 사용한다.
