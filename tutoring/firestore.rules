rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasValidRole() {
      return request.resource.data.role == null ||
          request.resource.data.role in ['tutor', 'tutee'];
    }

    function isClassMember(classId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    function isClassTutor(classId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/classes/$(classId)).data.tutorId ==
          request.auth.uid;
    }

    function isPublishedNote(classId, noteId) {
      return get(
        /databases/$(database)/documents/classes/$(classId)/notes/$(noteId)
      ).data.status == 'published';
    }

    // users/{uid}/reviews/{classId_quizId_questionId}: one item per wrong
    // question, owned by the learner. Tutors cannot read it.
    function isValidReview(uid, reviewId) {
      let data = request.resource.data;
      return data.userId == uid &&
        data.classId is string &&
        data.quizId is string &&
        data.questionId is string &&
        reviewId == data.classId + '_' + data.quizId + '_' + data.questionId &&
        data.status in ['needsReview', 'reviewed'] &&
        data.wrongCount is int &&
        data.wrongCount >= 1 &&
        data.lastSelectedOptionIndex is int &&
        data.topic is string &&
        data.prompt is string &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasValidRole();
      // Account deletion removes the profile from the client.
      allow delete: if isOwner(uid);

      match /classMemberships/{classId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          request.resource.data.classId == classId &&
          request.resource.data.role in ['tutor', 'tutee'] &&
          existsAfter(/databases/$(database)/documents/classes/$(classId));
        allow update: if isOwner(uid) &&
          request.resource.data.classId == classId;
        allow delete: if isOwner(uid) || isClassTutor(classId);
      }

      match /annotations/{annotationId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          request.resource.data.userId == uid &&
          request.resource.data.classId is string &&
          request.resource.data.noteId is string &&
          request.resource.data.type in [
            'highlight', 'memo', 'bookmark', 'drawing',
            'freehandHighlight', 'text'
          ] &&
          isClassMember(request.resource.data.classId) &&
          isPublishedNote(
            request.resource.data.classId,
            request.resource.data.noteId
          );
        allow update: if isOwner(uid) &&
          resource.data.userId == uid &&
          request.resource.data.userId == uid &&
          request.resource.data.classId == resource.data.classId &&
          request.resource.data.noteId == resource.data.noteId &&
          request.resource.data.type == resource.data.type &&
          isClassMember(resource.data.classId) &&
          isPublishedNote(resource.data.classId, resource.data.noteId);
        allow delete: if isOwner(uid) && resource.data.userId == uid;
      }

      match /quizAttempts/{attemptId} {
        allow read: if isOwner(uid) || isClassTutor(resource.data.classId);
        allow create: if isOwner(uid) &&
          request.resource.data.id == attemptId &&
          request.resource.data.userId == uid &&
          request.resource.data.classId is string &&
          request.resource.data.quizId is string &&
          request.resource.data.startedAt is timestamp &&
          request.resource.data.completedAt is timestamp &&
          request.resource.data.totalQuestions is int &&
          request.resource.data.totalQuestions > 0 &&
          request.resource.data.correctCount is int &&
          request.resource.data.correctCount >= 0 &&
          request.resource.data.correctCount <=
            request.resource.data.totalQuestions &&
          request.resource.data.answers is list &&
          request.resource.data.answers.size() ==
            request.resource.data.totalQuestions &&
          isClassMember(request.resource.data.classId) &&
          get(
            /databases/$(database)/documents/classes/$(request.resource.data.classId)/quizzes/$(request.resource.data.quizId)
          ).data.status == 'published';
        // Attempts are immutable; only account deletion removes them.
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /reviews/{reviewId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          isValidReview(uid, reviewId) &&
          request.resource.data.wrongCount == 1 &&
          isClassMember(request.resource.data.classId);
        allow update: if isOwner(uid) &&
          isValidReview(uid, reviewId) &&
          request.resource.data.classId == resource.data.classId &&
          request.resource.data.quizId == resource.data.quizId &&
          request.resource.data.questionId == resource.data.questionId &&
          request.resource.data.wrongCount >= resource.data.wrongCount;
        allow delete: if isOwner(uid);
      }
    }

    // Collection group query behind the tutor dashboard
    // (`collectionGroup('quizAttempts').where('classId', ==)`). Rules for a
    // collection group must use the recursive wildcard.
    match /{path=**}/quizAttempts/{attemptId} {
      allow read: if isSignedIn() && isClassTutor(resource.data.classId);
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.tutorId == request.auth.uid &&
        request.resource.data.memberCount == 1 &&
        request.resource.data.inviteCode is string;
      // Besides the tutor, a joining user may raise memberCount by one and
      // a current member may lower it by one while leaving.
      allow update: if isSignedIn() && (
        resource.data.tutorId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberCount', 'updatedAt']) &&
          (
            request.resource.data.memberCount == resource.data.memberCount + 1 ||
            (
              request.resource.data.memberCount == resource.data.memberCount - 1 &&
              isClassMember(classId)
            )
          )
        )
      );
      allow delete: if isSignedIn() && resource.data.tutorId == request.auth.uid;

      match /members/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid) &&
          request.resource.data.uid == uid &&
          request.resource.data.role in ['tutor', 'tutee'] &&
          (!('name' in request.resource.data) ||
            request.resource.data.name is string) &&
          existsAfter(/databases/$(database)/documents/classes/$(classId));
        allow update, delete: if isOwner(uid) ||
          get(/databases/$(database)/documents/classes/$(classId)).data.tutorId ==
            request.auth.uid;
      }


      // In-app notifications of the class: tutors announce publishes,
      // a joining student announces themself. Members read, nobody edits.
      match /notifications/{notificationId} {
        allow read: if isClassMember(classId) || isClassTutor(classId);
        allow create: if isSignedIn() &&
          request.resource.data.classId == classId &&
          request.resource.data.actorId == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.body is string &&
          request.resource.data.createdAt is timestamp &&
          (
            (
              request.resource.data.type in ['notePublished', 'quizPublished'] &&
              isClassTutor(classId)
            ) ||
            (
              request.resource.data.type == 'memberJoined' &&
              isClassMember(classId)
            )
          );
        allow update: if false;
        allow delete: if isClassTutor(classId);
      }

      match /notes/{noteId} {
        allow read: if isClassTutor(classId) ||
          (isClassMember(classId) && resource.data.status == 'published');
        allow create: if isClassTutor(classId) &&
          request.resource.data.classId == classId &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.status in ['draft', 'published'];
        allow update: if isClassTutor(classId) &&
          request.resource.data.classId == classId &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.status in ['draft', 'published'];
        allow delete: if isClassTutor(classId);

        match /blocks/{blockId} {
          allow read: if isClassTutor(classId) ||
            (isClassMember(classId) && isPublishedNote(classId, noteId));
          allow create, update: if isClassTutor(classId) &&
            request.resource.data.noteId == noteId &&
            request.resource.data.type in [
              'heading', 'heading2', 'heading3', 'paragraph', 'code',
              'image', 'quote', 'callout', 'quiz'
            ];
          allow delete: if isClassTutor(classId);
        }
      }

      match /quizzes/{quizId} {
        allow read: if isClassTutor(classId) ||
          (isClassMember(classId) &&
            resource.data.status == 'published');
        allow create: if isClassTutor(classId) &&
          request.resource.data.classId == classId &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.status in ['draft', 'published'];
        allow update: if isClassTutor(classId) &&
          request.resource.data.classId == classId &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.status in ['draft', 'published'];
        allow delete: if isClassTutor(classId);

        match /questions/{questionId} {
          allow read: if isClassTutor(classId) ||
            (isClassMember(classId) &&
              get(
                /databases/$(database)/documents/classes/$(classId)/quizzes/$(quizId)
              ).data.status == 'published');
          allow create, update: if isClassTutor(classId) &&
            request.resource.data.quizId == quizId &&
            request.resource.data.type == 'multipleChoice' &&
            request.resource.data.prompt is string &&
            request.resource.data.options is list &&
            request.resource.data.options.size() == 4 &&
            request.resource.data.correctOptionIndex is int &&
            request.resource.data.explanation is string &&
            request.resource.data.order is int &&
            (
              getAfter(
                /databases/$(database)/documents/classes/$(classId)/quizzes/$(quizId)
              ).data.status == 'draft' ||
              (
                request.resource.data.correctOptionIndex >= 0 &&
                request.resource.data.correctOptionIndex < 4
              )
            );
          allow delete: if isClassTutor(classId);
        }
      }
    }
  }
}
