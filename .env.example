# GreenLink Backend 배포용 .env 템플릿 — 이 파일을 .env로 복사해 값을 채운다. (.env는 커밋 금지)
# 저장소 루트의 docker-compose.prod.yml이 읽는다.

# 서버에서 열 포트 (8081, 8082, 8084~8099 중 미사용). Cloudflare 터널 규칙의 포트와 같아야 한다.
GREENLINK_PORT=8085

# MySQL — 컨테이너 내부 DB. 둘 다 무작위 값 사용 (openssl rand -hex 24)
DB_PASSWORD=<db-password>
DB_ROOT_PASSWORD=<db-root-password>

# JWT 서명 키 — 32바이트 이상 (openssl rand -base64 48)
JWT_SECRET=<jwt-secret>

# 식물 사진 보관 기간(일). 지난 사진은 매일 04시에 정리하되 식물별 최신 사진은 남긴다.
GREENLINK_IMAGE_RETENTION_DAYS=30

# OAuth (토큰/사용자 정보 URI는 application.yaml 기본값 사용)
OAUTH_KAKAO_CLIENT_ID=<kakao-rest-api-key>
OAUTH_KAKAO_CLIENT_SECRET=<kakao-client-secret>
OAUTH_GOOGLE_CLIENT_ID=<google-client-id>
OAUTH_GOOGLE_CLIENT_SECRET=<google-client-secret>

# 최초 관리자 — ADMIN이 한 명도 없을 때만 생성(비밀번호 12자 이상). 생성·로그인 확인 후 두 줄을 지운다.
GREENLINK_BOOTSTRAP_ADMIN_EMAIL=<admin-email>
GREENLINK_BOOTSTRAP_ADMIN_PASSWORD=<admin-password>
