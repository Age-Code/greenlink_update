; secrets.ini 템플릿
;
; 이 파일을 같은 디렉터리에 secrets.ini로 복사한 뒤 실제 값을 채운다.
; platformio.ini가 extra_configs로 읽어들이며, 파일이 없으면 빌드가 실패한다.
; 문자열 값은 반드시 '"..."' 형태로 따옴표를 감싸야 한다.
;
; 보드마다 GREENLINK_DEVICE_KEY와 보정값(DRY_RAW/WET_RAW)이 다르므로,
; 플래시할 보드에 맞춰 아래 값을 바꾼 뒤 빌드한다.

[secrets]
build_flags =
    -D GREENLINK_WIFI_SSID='"<wifi-ssid>"'
    -D GREENLINK_WIFI_PASSWORD='"<wifi-password>"'
    -D GREENLINK_SERVER_URL='"<backend-base-url>/api/iot/esp/soil-moisture"'
    -D GREENLINK_DEVICE_KEY='"<esp-device-key>"'
    -D GREENLINK_DRY_RAW=<dry-soil-raw>
    -D GREENLINK_WET_RAW=<wet-soil-raw>
    ; (선택) 이 값보다 큰 raw는 센서 이탈로 보고 전송하지 않는다.
    ; 생략하면 DRY_RAW + (DRY_RAW - WET_RAW). 공기 중 raw보다 작고 마른 흙 raw보다 커야 한다.
    ; -D GREENLINK_SENSOR_FAULT_RAW=<sensor-fault-raw>

; 토양수분 보정값 (percent = (DRY_RAW - raw) / (DRY_RAW - WET_RAW) * 100)
;
; 해바라기 보드는 아래 값이 현장 측정으로 확정된 값이다.
;   -D GREENLINK_DRY_RAW=1700
;   -D GREENLINK_WET_RAW=1300
;
; 주의: 바질 보드의 보정값은 아직 실측되지 않았다.
; 해바라기 값을 그대로 쓰면 수분 퍼센트가 부정확해지고
; 자동 급수 판단까지 함께 틀어지므로, 바질 센서로 직접 측정한 뒤 채워야 한다.
; 측정 절차: 마른 흙에 꽂아 raw 기록 -> 충분히 적신 흙에 꽂아 raw 기록.
